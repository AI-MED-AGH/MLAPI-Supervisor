# --- required ---
# Generate with:  python -m app.admin_key   (prints the key and the hash below)
ADMIN_API_KEYS=
REDIS_PASSWORD=change-me-to-a-long-random-string

# --- needed only for queue-mode models (long-running jobs) ---
QUEUE_ACL_SECRET=

# --- optional ---
# Poll this GitHub organisation's container registry for model images (needs a token with read:packages)
GHCR_ORG=
GHCR_TOKEN=
# Use an external Postgres instead of the default SQLite file
DATABASE_URL=
ROUTER_PORT=8000
ROUTER_BIND=127.0.0.1
SUPERVISOR_PORT=8001
